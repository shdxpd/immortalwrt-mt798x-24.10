 o2.group = {}
 
+o = s:option(ListValue, _n("bind_iface"), translate("Bind Interface"), translate("Connect to this node only via the selected WAN. Ignored when a preproxy node is set."))
+o:value("", translate("Auto"))
+api.uci:foreach("network", "interface", function(e)
+	local n, proto = e[".name"], e.proto
+	if n ~= "loopback" and n ~= "lan" and (proto == "pppoe" or proto == "dhcp" or proto == "static") then
+		o:value(n, n .. " (" .. (proto == "pppoe" and ("pppoe-" .. n) or (e.device or n)) .. ")")
+	end
+end)
+for i, v in ipairs(s.fields[_n("protocol")].keylist) do
+	if not v:find("_") then
+		o:depends({ [_n("protocol")] = v })
+	end
+end
+
 for k, v in pairs(nodes_table) do
 	if v.type == "sing-box" and v.id ~= arg[1] and (not v.chain_proxy or v.chain_proxy == "") then
 		o1:value(v.id, v.remark)
