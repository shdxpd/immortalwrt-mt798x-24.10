+local function iface_l3_device(ifname)
+	local dev = sys.exec(string.format("ubus call network.interface.%s status 2>/dev/null | jsonfilter -e '@.l3_device'", ifname)):gsub("%s+", "")
+	if dev == "" then
+		local proto = uci:get("network", ifname, "proto")
+		dev = (proto == "pppoe") and ("pppoe-" .. ifname) or (uci:get("network", ifname, "device") or ifname)
+	end
+	return dev
+end
