+local version_ge_1_14_0 = api.compare_versions(local_version, ">=", "1.14.0")
 
 local geosite_all_tag = {}
 local geoip_all_tag = {}
+local custom_rule_set = {}  -- rule-set:remote:URL / rule-set:local:PATH
+
+-- w 去掉 "rule-set:" 前缀后的部分，如 remote:https://x/geosite-cn.srs、local:/path/a.json
+local function parse_rule_set(w)
+	local _type, src = w:match("^(%a+):(.+)$")
+	if _type ~= "remote" and _type ~= "local" then return nil end
+	local filename = src:match("([^/]+)$") or ""
+	local name, suffix = filename:match("^(.-)%.(%w+)$")
+	local format = (suffix == "srs" and "binary") or (suffix == "json" and "source") or nil
+	if not format or not name or name == "" then return nil end
+	local tag = "rs_" .. name
+	local base, i = tag, 1
+	while custom_rule_set[tag] and (custom_rule_set[tag].url or custom_rule_set[tag].path) ~= src do
+		i = i + 1
+		tag = base .. "_" .. i
+	end
+	custom_rule_set[tag] = {
+		type = _type,
+		tag = tag,
+		format = format,
+		path = _type == "local" and src or nil,
+		url = _type == "remote" and src or nil,
+	}
+	return tag
+end
